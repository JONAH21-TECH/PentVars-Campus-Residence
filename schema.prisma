// PentVars Campus Residence - Prisma schema (draft)
// Extends the draft in schema.md with the tables that were missing from it:
// users, halls, floors, students, hall_staff, fee_verifications.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum Role {A
  STUDENT
  SRC_MEMBER
  HALL_REP
  HALL_STAFF   // Hall Master & Deputy (equal permissions)
  MANAGEMENT   // School management / executives
}

enum Gender {
  MALE
  FEMALE
}

enum HallType {
  MIXED
  MALE_ONLY
  FEMALE_ONLY
}

enum Wing {
  LEFT
  RIGHT
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
}

enum FloorStatus {
  ACTIVE
  VACANT // e.g. Anan Hall 4th floor
}

enum AssignmentStatus {
  ACTIVE
  MOVED_OUT
}

enum SwitchStatus {
  PENDING
  APPROVED
  DENIED
}

enum FeeType {
  HALL_FEE
  DAMAGE_CHARGE
  OTHER
}

enum FeeStatus {
  PENDING
  VERIFIED
  PAID
  WAIVED // SRC members
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum IncidentStatus {
  UNDER_INVESTIGATION
  RESOLVED
}

// Extensible: hall rep positions and staff titles are data, not code.
enum HallPosition {
  HALL_MASTER
  DEPUTY_HALL_MASTER
  PRESIDENT
  DEPUTY_PRESIDENT
  FINANCIAL_CONTROLLER
  SRC_REPRESENTATIVE
  OTHER
}

// ---------- Identity ----------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  fullName     String
  role         Role
  createdAt    DateTime @default(now())

  student  Student?
  hallRole HallStaff?

  reviewedSwitches    RoomSwitchRequest[] @relation("SwitchReviewer")
  feeVerifications    FeeVerification[]
}

model Student {
  id            String  @id @default(cuid())
  userId        String  @unique
  studentNumber String  @unique
  gender        Gender
  programme     String
  level         Int
  isActive      Boolean @default(true) // active/valid student status
  isSrc         Boolean @default(false)
  // SRC members already have a hall from admission
  hallId        String?

  user        User                @relation(fields: [userId], references: [id])
  hall        Hall?               @relation(fields: [hallId], references: [id])
  applications Application[]
  assignments RoomAssignment[]
  switches    RoomSwitchRequest[]
  fees        Fee[]
  incidentsResponsible Incident[] @relation("ResponsibleStudent")
}

// Hall Master, Deputy, and hall representatives (President, Deputy, ...)
model HallStaff {
  id        String       @id @default(cuid())
  userId    String       @unique
  hallId    String
  position  HallPosition
  // Reps live in the executive wings; staff are non-resident
  roomId    String?

  user User @relation(fields: [userId], references: [id])
  hall Hall @relation(fields: [hallId], references: [id])
  room Room? @relation(fields: [roomId], references: [id])

  @@index([hallId, position])
}

// ---------- Buildings ----------

model Hall {
  id     String   @id @default(cuid())
  name   String   @unique // Anan Hall, Sappho Hall, Yeboah Hall
  type   HallType

  floors   Floor[]
  students Student[]
  staff    HallStaff[]
}

model Floor {
  id     String      @id @default(cuid())
  hallId String
  number Int         // 0 = ground
  gender Gender?     // null = follows hall type (Anan floors are assigned per floor)
  status FloorStatus @default(ACTIVE)

  hall  Hall   @relation(fields: [hallId], references: [id])
  rooms Room[]

  @@unique([hallId, number])
}

model Room {
  id          String     @id @default(cuid())
  floorId     String
  roomNumber  String
  wing        Wing?
  isExecutive Boolean    @default(false) // reserved for SRC members / hall reps (not on ground floor)
  capacity    Int        // executive rooms cap at 3
  status      RoomStatus @default(AVAILABLE)

  floor       Floor               @relation(fields: [floorId], references: [id])
  assignments RoomAssignment[]
  currentFor  RoomSwitchRequest[] @relation("CurrentRoom")
  requestedBy RoomSwitchRequest[] @relation("RequestedRoom")
  incidents   Incident[]
  staff       HallStaff[]

  @@unique([floorId, roomNumber])
}

// ---------- Application and fees ----------

// Tracks a student's path to unlocking room selection
model Application {
  id        String   @id @default(cuid())
  studentId String
  // Soft flag for staff awareness only, not a system-enforced block
  avoidNote String?
  createdAt DateTime @default(now())
  // Set once all required verifications are approved
  unlockedAt DateTime?

  student Student @relation(fields: [studentId], references: [id])
  fee     Fee?
}

model Fee {
  id             String    @id @default(cuid())
  studentId      String
  applicationId  String?   @unique
  incidentId     String?
  amount         Decimal   @db.Decimal(10, 2) // GHS
  type           FeeType
  status         FeeStatus @default(PENDING)
  paymentSlipUrl String?
  createdAt      DateTime  @default(now())

  student       Student       @relation(fields: [studentId], references: [id])
  application   Application?  @relation(fields: [applicationId], references: [id])
  incident      Incident?     @relation(fields: [incidentId], references: [id])
  verifications FeeVerification[]
}

// One row per required verifier: Hall Master, Deputy, Hall President, Deputy President.
// SRC members have a single row from their hall's SRC representative.
model FeeVerification {
  id         String             @id @default(cuid())
  feeId      String
  verifierId String
  position   HallPosition
  status     VerificationStatus @default(PENDING)
  decidedAt  DateTime?

  fee      Fee  @relation(fields: [feeId], references: [id])
  verifier User @relation(fields: [verifierId], references: [id])

  @@unique([feeId, verifierId])
}

// ---------- Rooms in use ----------

model RoomAssignment {
  id           String           @id @default(cuid())
  studentId    String
  roomId       String
  dateAssigned DateTime         @default(now())
  status       AssignmentStatus @default(ACTIVE)

  student Student @relation(fields: [studentId], references: [id])
  room    Room    @relation(fields: [roomId], references: [id])

  @@index([roomId, status])
  @@index([studentId, status])
}

model RoomSwitchRequest {
  id              String       @id @default(cuid())
  studentId       String
  currentRoomId   String
  requestedRoomId String
  reason          String
  status          SwitchStatus @default(PENDING)
  reviewedById    String?
  createdAt       DateTime     @default(now())

  student       Student @relation(fields: [studentId], references: [id])
  currentRoom   Room    @relation("CurrentRoom", fields: [currentRoomId], references: [id])
  requestedRoom Room    @relation("RequestedRoom", fields: [requestedRoomId], references: [id])
  reviewedBy    User?   @relation("SwitchReviewer", fields: [reviewedById], references: [id])
}

model Incident {
  id                   String         @id @default(cuid())
  roomId               String
  description          String
  status               IncidentStatus @default(UNDER_INVESTIGATION)
  // null = no individual found, cost is split evenly across room occupants
  responsibleStudentId String?
  createdAt            DateTime       @default(now())

  room               Room     @relation(fields: [roomId], references: [id])
  responsibleStudent Student? @relation("ResponsibleStudent", fields: [responsibleStudentId], references: [id])
  charges            Fee[]
}
